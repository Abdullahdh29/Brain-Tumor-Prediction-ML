# ---------------------------------------------------------------------------
# API configuration for the Brain Cancer Prediction app.
#
# Copy this file to ".env" (it is gitignored and will NOT be committed).
# The value must match the X-API-KEY header sent by the client when
# authentication is enabled (set API_KEY in .env).
# Note: The browser page does NOT embed or send a hard-coded key. The
# JavaScript only sends the JSON prediction payload to /predict.


# ---------------------------------------------------------------------------
API_KEY=rf_api_key
